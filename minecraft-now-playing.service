[Unit]
Description=Minecraft Now Playing Board Updater
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/neurobomber/Apps/games/minecraft/pixelreel
ExecStart=/home/neurobomber/Apps/games/minecraft/pixelreel/update_now_playing.py
Restart=always
RestartSec=10
User=neurobomber

[Install]
WantedBy=multi-user.target
